# /etc/artemis/lead-relay.env (root:root 600). No secrets here: Gmail access is the existing
# Google Workspace domain-wide delegation of /opt/email-engine; Telegram token stays in artemis.env.
ARTEMIS_LEAD_EMAIL_TO=info@artemisresort.com
ARTEMIS_LEAD_EMAIL_FROM=info@oxfordframe.com
ARTEMIS_DB=/var/www/artemis/leads.db
ARTEMIS_RELAY_STATE=/var/lib/artemis-lead-relay/state.db
ARTEMIS_ENV_FILE=/etc/artemis/artemis.env
# Copy is sent only while the recipient domain has MX (default 1). Without MX leads stay queued.
#ARTEMIS_LEAD_EMAIL_REQUIRE_MX=1
# Send errors: exponential backoff 1,2,4… min (max 6 h), then parked; --requeue to retry.
#ARTEMIS_LEAD_EMAIL_MAX_ATTEMPTS=8
